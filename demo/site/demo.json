{
 "lines": [
  {
   "id": "L000001",
   "start": 1.216,
   "end": 4.74,
   "spk": "S1",
   "emotion": "neutral",
   "arousal": 0,
   "text": "Riverside Rovers on the ball now, Okafor brings it forward.",
   "conf": "new",
   "stages": {
    "heard": 0.52,
    "text": 0.91,
    "speaker": 0.82,
    "voice_first": 2.35
   }
  },
  {
   "id": "L000002",
   "start": 5.216,
   "end": 8.74,
   "spk": "S2",
   "emotion": "neutral",
   "arousal": 0,
   "text": "They've been patient all evening, waiting for a gap to open up.",
   "conf": "new",
   "stages": {
    "heard": 0.52,
    "text": 0.87,
    "speaker": 0.35,
    "voice_first": 1.76
   }
  },
  {
   "id": "L000003",
   "start": 9.376,
   "end": 12.51,
   "spk": "S1",
   "emotion": "neutral",
   "arousal": 0,
   "text": "Lindqvist out wide he looks up, Tanaka is making the run.",
   "conf": "high",
   "stages": {
    "heard": 0.49,
    "text": 0.47,
    "speaker": 0.35,
    "voice_first": 1.19
   }
  },
  {
   "id": "L000004",
   "start": 12.896,
   "end": 15.39,
   "spk": "S1",
   "emotion": "neutral",
   "arousal": 0.79,
   "text": "TANAKA is through on goal. He goes round the keeper.",
   "conf": "high",
   "stages": {
    "heard": 0.36,
    "text": 0.35,
    "speaker": 0.22,
    "voice_first": 1.17
   }
  },
  {
   "id": "L000005",
   "start": 15.52,
   "end": 20.35,
   "spk": "S2",
   "emotion": "excited",
   "arousal": 1.69,
   "text": "Goal TANAKA scores for Riverside. What a finish. Calm as a rock, you made that look so easy.",
   "conf": "high",
   "stages": {
    "heard": 0.41,
    "text": 0.52,
    "speaker": 0.57,
    "voice_first": 1.67
   }
  },
  {
   "id": "L000006",
   "start": 20.832,
   "end": 23.78,
   "spk": "S1",
   "emotion": "excited",
   "arousal": 1.32,
   "text": "1-0 to the Rovers, and the whole stadium is on its feet.",
   "conf": "high",
   "stages": {
    "heard": 0.48,
    "text": 0.4,
    "speaker": 0.23,
    "voice_first": 1.12
   }
  },
  {
   "id": "L000007",
   "start": 24.288,
   "end": 27.17,
   "spk": "S2",
   "emotion": "neutral",
   "arousal": 0.2,
   "text": "That run from Lindqvist opened everything up for him.",
   "conf": "high",
   "stages": {
    "heard": 0.59,
    "text": 0.51,
    "speaker": 0.2,
    "voice_first": 1.21
   }
  },
  {
   "id": "L000008",
   "start": 27.584,
   "end": 30.11,
   "spk": "S1",
   "emotion": "neutral",
   "arousal": -0.01,
   "text": "Northgate kick off again, they need a response now.",
   "conf": "high",
   "stages": {
    "heard": 0.39,
    "text": 0.51,
    "speaker": 0.19,
    "voice_first": 1.35
   }
  },
  {
   "id": "L000009",
   "start": 30.784,
   "end": 33.57,
   "spk": "S2",
   "emotion": "neutral",
   "arousal": -0.02,
   "text": "Plenty of time left, but they'll have to take more risks.",
   "conf": "high",
   "stages": {
    "heard": 0.44,
    "text": 3.12,
    "speaker": 0.21,
    "voice_first": 3.96
   }
  }
 ],
